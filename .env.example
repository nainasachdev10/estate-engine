# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-key

# Voice (Bolna)
BOLNA_API_KEY=your-bolna-key
BOLNA_AGENT_ID=your-agent-id
BOLNA_FROM_NUMBER=+91XXXXXXXXXX
BOLNA_WEBHOOK_SECRET=your-webhook-secret

# Test data
TEST_PHONE=+91XXXXXXXXXX
TEST_PROJECT_ID=

# Sarvam (STT/TTS fallback)
SARVAM_API_KEY=your-sarvam-key

# Messaging global kill switch (set to 'false' to pause all WhatsApp + email)
MESSAGING_ENABLED=true

# Internal API secret (random 32-char string — protects Claude-burning routes)
INTERNAL_API_SECRET=

# WhatsApp (AiSensy)
AISENSY_API_KEY=your-aisensy-key
AISENSY_SENDER_ID=your-sender-id

# Email (Brevo)
BREVO_API_KEY=your-brevo-key
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Realty Engine

# Inngest
INNGEST_EVENT_KEY=your-event-key
INNGEST_SIGNING_KEY=your-signing-key

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Social (set SOCIAL_PROVIDER=ayrshare or postiz)
SOCIAL_PROVIDER=ayrshare
AYRSHARE_API_KEY=your-ayrshare-key
POSTIZ_API_KEY=your-postiz-key
POSTIZ_API_URL=https://api.postiz.com/v1/posts

# Meta Ads API
META_ACCESS_TOKEN=your-meta-access-token
META_AD_ACCOUNT_ID=your-ad-account-id
META_PAGE_ID=your-facebook-page-id

# App
APP_URL=http://localhost:3000
