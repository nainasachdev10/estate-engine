# ============================================================
# Realty Engine — Environment Variables
# Copy this file to .env.local (dev) or paste into Vercel (prod)
# Never commit your actual .env.local to git
# ============================================================

# === App ===
NODE_ENV=production                              # production | development
APP_URL=https://your-app.vercel.app             # server-side base URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app # browser-side base URL (no trailing slash)

# Internal API secret — set BOTH to the same random value (openssl rand -hex 32)
# Server-side guard on Claude-burning routes (creatives, social generate)
# NEXT_PUBLIC_ version is read by browser components to pass as X-Internal-Token header
INTERNAL_API_SECRET=
NEXT_PUBLIC_INTERNAL_API_SECRET=

# Comma-separated admin emails that can access the operator dashboard
ADMIN_EMAILS=admin@yourdomain.com

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Anthropic (Claude) ===
ANTHROPIC_API_KEY=your-anthropic-key

# === Voice (Bolna) ===
BOLNA_API_KEY=your-bolna-key
BOLNA_AGENT_ID=your-agent-id
BOLNA_FROM_NUMBER=+91XXXXXXXXXX
BOLNA_WEBHOOK_SECRET=your-bolna-webhook-secret  # shared secret for HMAC signature verification

# === WhatsApp (AiSensy) ===
AISENSY_API_KEY=your-aisensy-key
AISENSY_SENDER_ID=your-sender-id
AISENSY_WEBHOOK_SECRET=your-aisensy-webhook-secret
# Name of the AiSensy "Session Message" campaign for free-form replies after the 24hr window
AISENSY_SESSION_CAMPAIGN=freeform_session

# === Email (Brevo) ===
BREVO_API_KEY=your-brevo-key
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Realty Engine
BREVO_WEBHOOK_TOKEN=optional-shared-secret-in-webhook-url  # optional; validates inbound Brevo delivery events

# === Higgsfield (AI image + video generation) ===
HIGGSFIELD_API_KEY=your-higgsfield-key

# === Meta Ads API ===
META_ACCESS_TOKEN=your-meta-access-token        # system user or user access token — for Marketing API (ads)
META_AD_ACCOUNT_ID=act_XXXXXXXXXXXXXXXXX        # format: act_ prefix + numeric ID
META_PAGE_ID=your-facebook-page-id
META_APP_SECRET=from-meta-app-settings-basic    # used to verify webhook X-Hub-Signature-256 headers

# === Meta Organic Publishing (Instagram + Facebook) ===
META_PAGE_ACCESS_TOKEN=your-page-access-token   # long-lived page token; separate from META_ACCESS_TOKEN
META_IG_BUSINESS_ID=your-ig-business-account-id # Instagram Business Account ID (not the @handle)

# === Meta Lead Ads webhook ===
# Single account-wide webhook at /api/leads/meta-lead-ads-webhook (not per-project).
# Leads are routed to a project via campaigns.external_campaign_id (set automatically
# on "Launch on Meta") or campaigns.lead_form_id (set per campaign in the dashboard).
META_WEBHOOK_VERIFY_TOKEN=pick-any-secret-string-you-want  # you define this; put same value in Meta App webhook settings

# === Inngest (workflow orchestration) ===
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# === Social media publishing ===
# Set SOCIAL_PROVIDER to control which publisher is active
SOCIAL_PROVIDER=mock                            # mock | postiz | ayrshare | meta
AYRSHARE_API_KEY=your-ayrshare-key
POSTIZ_API_KEY=your-postiz-key
POSTIZ_API_URL=https://api.postiz.com/v1/posts

# === PostHog (analytics) ===
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# === Slack (operator alerts) ===
# Set this to get Slack notifications for stuck leads and daily reports
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# === Test / dev helpers (not used in production) ===
TEST_PHONE=+91XXXXXXXXXX
TEST_PROJECT_ID=

# === Sarvam (STT/TTS fallback — optional) ===
SARVAM_API_KEY=your-sarvam-key

# === Messaging kill switch ===
# Set to 'false' to instantly pause all WhatsApp + email sends without redeploying
MESSAGING_ENABLED=true
